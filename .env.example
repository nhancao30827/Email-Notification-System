# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=email_distribution

# Full async DSN used by SQLAlchemy / Alembic
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/email_distribution

# CORS — space-separated list of allowed origins, e.g. "https://app.example.com"
CORS_ORIGINS=["http://localhost:3000"]

# JWT
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAPI docs — remove or set empty to disable in production
# DOCS_URL=
# REDOC_URL=

